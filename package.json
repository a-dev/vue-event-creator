{
  "version": "1.0.4",
  "name": "vue-event-creator",
  "description": "Vue.js library for an admin interface: easy way to schedule events in the calendar",
  "license": "MIT",
  "author": "@a-dev <andytev@gmail.com>",
  "main": "./dist/vue-event-creator.min.umd.js",
  "types": "./src/index.d.ts",
  "module": "./dist/vue-event-creator.min.es.js",
  "unpkg": "./dist/vue-event-creator.min.umd.js",
  "style": "./dist/styles.css",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a-dev/vue-event-creator"
  },
  "homepage": "https://a-dev.github.io/vue-event-creator/",
  "bugs": {
    "url": "https://github.com/a-dev/vue-event-creator/issues"
  },
  "files": [
    "package.json",
    "/dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite serve demo/",
    "build_old": "rollup --config rollup.config.js --bundleConfigAsCjs",
    "build": "vite build --emptyOutDir",
    "build:demo": "vite build demo/ --emptyOutDir",
    "serve": "vite preview demo-app --host",
    "test": "jest tests/unit --coverage",
    "update:check": "npx npm-check-updates --packageManager bun --cooldown 2",
    "update:interactive": "npx npm-check-updates --interactive -u --packageManager bun --cooldown 2"
  },
  "dependencies": {
    "dayjs": "^1.11.23",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0"
  },
  "peerDependencies": {
    "vue": "^3.x"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@types/jest": "^30.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/compiler-sfc": "^3.5.42",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/vue3-jest": "29",
    "autoprefixer": "^10.4.14",
    "babel-jest": "^30.5.1",
    "eslint": "^8.46.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-standard": "^5.0.0",
    "eslint-plugin-vue": "^10.10.0",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "jest-transform-stub": "^2.0.0",
    "postcss": "^8.4.27",
    "terser": "^5.51.2",
    "ts-jest": "^29.4.12",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vue": "^3.5.42",
    "vue-template-compiler": "^2.7.16",
    "vue-tsc": "^3.3.11"
  }
}
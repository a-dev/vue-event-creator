{
  "name": "vue-event-creator",
  "version": "2.0.0",
  "description": "Vue.js library for an admin interface: easy way to schedule events in the calendar",
  "homepage": "https://a-dev.github.io/vue-event-creator/",
  "bugs": {
    "url": "https://github.com/a-dev/vue-event-creator/issues"
  },
  "license": "MIT",
  "author": "@a-dev <andytev@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a-dev/vue-event-creator.git"
  },
  "style": "./dist/style.css",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": {
      "types": "./dist/style.css.d.ts",
      "default": "./dist/style.css"
    }
  },
  "scripts": {
    "dev": "vite serve demo/",
    "build_old": "rollup --config rollup.config.js --bundleConfigAsCjs",
    "build": "vite build --emptyOutDir && bun run build:types",
    "build:types": "vue-tsc --project tsconfig.build.json --declaration --emitDeclarationOnly",
    "build:demo": "vite build demo/ --emptyOutDir",
    "serve": "vite preview demo --host",
    "test": "TZ=UTC vitest run",
    "test:unit": "TZ=UTC vitest run --project unit",
    "test:browser": "TZ=UTC vitest run --project browser",
    "test:watch": "TZ=UTC vitest",
    "test:coverage": "TZ=UTC vitest run --coverage",
    "test:e2e": "TZ=UTC playwright test",
    "test:e2e:demo": "TZ=UTC playwright test --project demo-chromium",
    "test:e2e:packed": "TZ=UTC playwright test --project packed-chromium",
    "typecheck": "vue-tsc --noEmit",
    "lint": "oxlint --vue-plugin src demo tests scripts vite.config.ts vitest.config.ts playwright.config.ts demo/vite.config.ts",
    "format": "oxfmt --write src demo tests scripts vite.config.ts vitest.config.ts playwright.config.ts demo/vite.config.ts tsconfig.json tsconfig.build.json package.json",
    "format:check": "oxfmt --check src demo tests scripts vite.config.ts vitest.config.ts playwright.config.ts demo/vite.config.ts tsconfig.json tsconfig.build.json package.json",
    "package:lint": "publint",
    "package:types": "NPM_CONFIG_CACHE=/tmp/vue-event-creator-npm-cache attw --pack . --profile esm-only",
    "package:dry-run": "NPM_CONFIG_CACHE=/tmp/vue-event-creator-npm-cache npm pack --dry-run",
    "package:consumer": "node scripts/test-packed-consumer.mjs",
    "package:check": "bun run package:lint && bun run package:types && bun run package:dry-run && bun run package:consumer",
    "release:check": "bun run format:check && bun run typecheck && bun run lint && bun run test && bun run build && bun run package:check && bun run test:e2e",
    "prepublishOnly": "bun run release:check",
    "update:check": "npx npm-check-updates --packageManager bun --cooldown 2",
    "update:interactive": "npx npm-check-updates --interactive -u --packageManager bun --cooldown 2"
  },
  "dependencies": {
    "dayjs": "^1.11.23"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@playwright/test": "^1.62",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/browser-playwright": "^5",
    "@vitest/coverage-v8": "^5",
    "@vue/compiler-sfc": "^3.5.42",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "autoprefixer": "^10.5.5",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-standard": "^5.0.0",
    "eslint-plugin-vue": "^10.10.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "publint": "^0.3.24",
    "terser": "^5.51.2",
    "tslib": "^2.8.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.2.2",
    "vitest": "^5",
    "vue": "^3.5.42",
    "vue-template-compiler": "^2.7.16",
    "vue-tsc": "^3.3"
  },
  "peerDependencies": {
    "vue": "^3.x"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.4.1"
}
